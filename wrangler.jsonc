{
  "name": "torn-oc-manager",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "assets": {"directory":"./public","binding":"ASSETS","run_worker_first":true},
  "triggers": {"crons":["*/5 * * * *"]},
  "d1_databases": [{"binding":"DB","database_name":"oc-manager","database_id":"REPLACE_WITH_YOUR_D1_DATABASE_ID"}]
}
